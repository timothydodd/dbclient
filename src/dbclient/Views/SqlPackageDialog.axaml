<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="dbclient.Views.SqlPackageDialog"
        Title="SqlPackage"
        Width="640"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <DockPanel>
        <!-- Title Bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource TitleBarBackground}"
                Height="32"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TitleText"
                           Text="SqlPackage"
                           Foreground="{DynamicResource TitleBarForeground}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0"/>
                <Button Grid.Column="1"
                        Click="CloseOrCancel_Click"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Classes="close">
                    <Path Data="M18 6 6 18M6 6l12 12"
                          Stroke="{DynamicResource TitleBarForeground}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          Stretch="Uniform"
                          Width="12" Height="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource TitleBarBackground}"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CancelButton" Content="Cancel" Click="CloseOrCancel_Click" MinWidth="80"/>
                    <Button x:Name="CloseButton" Content="Close" Click="CloseOrCancel_Click" MinWidth="80" Classes="primary" IsVisible="False"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Running..."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid RowDefinitions="Auto,*" Margin="16,12">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,8"/>
            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="3">
                <ScrollViewer x:Name="LogScroll" Padding="8">
                    <SelectableTextBlock x:Name="LogText"
                                         FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                         FontSize="11"
                                         Foreground="{DynamicResource SecondaryText}"
                                         TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>

    <Window.Styles>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#ff5555"/>
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#bd93f9"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="#282a36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#caa4fa"/>
        </Style>
    </Window.Styles>
</Window>
